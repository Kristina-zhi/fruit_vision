<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.5.xsd">
    <changeSet id="002" author="fruit-vision">
        <createTable tableName="analyzes">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="file_name" type="VARCHAR(500)"><constraints nullable="false"/></column>
            <column name="file_path" type="VARCHAR(1000)"><constraints nullable="false"/></column>
            <column name="user_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_analyze_user" references="users(id)"/></column>
            <column name="analyzed_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>
</databaseChangeLog>
