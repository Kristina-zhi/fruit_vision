<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.5.xsd">
    <changeSet id="007" author="fruit-vision">
        <createTable tableName="fruit_minerals">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="fruit_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_mineral_fruit" references="fruits(id)"/></column>
            <column name="mineral_name" type="VARCHAR(150)"><constraints nullable="false"/></column>
            <column name="amount" type="VARCHAR(50)"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>
</databaseChangeLog>
